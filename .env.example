# === LLM keys ===
# Можно задать здесь И/ИЛИ в UI приложения (⚙ Настройки ИИ → localStorage).
# UI-ключ перекрывает .env на время запроса; пустой UI → берётся .env.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_API_KEY_2="MY_BACKUP_GEMINI_API_KEY"
# GEMINI_API_KEY_3="MY_SECOND_BACKUP_KEY"

# NVIDIA NIM — https://build.nvidia.com/ → Get API Key
# NVIDIA_API_KEY="nvapi-XXXXXXXX"
# NVIDIA_API_KEY_2="nvapi-BACKUP"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_DEFAULT_MODEL="deepseek-ai/deepseek-v4-flash"
# NVIDIA_FALLBACK_MODELS="deepseek-ai/deepseek-v4-pro,qwen/qwen3.5-122b-a10b,mistralai/mistral-medium-3.5-128b"
# NVIDIA_REQUEST_TIMEOUT_MS=90000
# NVIDIA_COOLDOWN_MS=90000

# Groq (быстрый free) — https://console.groq.com
# GROQ_API_KEY="gsk_..."
# GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"
# GROQ_FALLBACK_MODELS="llama-3.1-8b-instant,gemma2-9b-it"

# OpenRouter (много :free моделей) — https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_DEFAULT_MODEL="openrouter/free"
# OPENROUTER_FALLBACK_MODELS="google/gemma-4-26b-a4b-it:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-20b:free"

# GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.0-flash"

# === Выбор провайдера (по умолчанию; UI перекрывает) ===
# auto | gemini | nvidia | groq | openrouter
# auto = Gemini → NVIDIA → Groq → OpenRouter
# LLM_PROVIDER="auto"

# APP_URL: URL приложения (Cloud Run / локально)
APP_URL="http://localhost:3000"
